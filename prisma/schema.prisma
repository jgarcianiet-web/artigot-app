generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Puestos: CAMARERO | MAITRE | MOZO
model Worker {
  id              String           @id @default(cuid())
  name            String
  phone           String
  email           String?
  role            String
  rating          Int              @default(3)
  zone            String?
  notes           String?
  active          Boolean          @default(true)
  token           String           @unique
  createdAt       DateTime         @default(now())
  unavailabilities Unavailability[]
  assignments     Assignment[]
}

// Días en los que el trabajador no está disponible (fecha YYYY-MM-DD)
model Unavailability {
  id       String @id @default(cuid())
  workerId String
  date     String
  reason   String?
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([date])
}

// Tipos: BODA | EVENTO | OTRO. Estado: ABIERTO | CERRADO
model Event {
  id            String       @id @default(cuid())
  name          String
  type          String       @default("BODA")
  date          String
  startTime     String
  endTime       String?
  unloadTime    String?
  venue         String
  client        String?
  notes         String?
  needCamareros Int          @default(0)
  needMaitres   Int          @default(0)
  needMozos     Int          @default(0)
  status        String       @default("ABIERTO")
  createdAt     DateTime     @default(now())
  assignments   Assignment[]

  @@index([date])
}

// Estado: CONVOCADO | CONFIRMADO | RECHAZADO | CANCELADO
model Assignment {
  id            String    @id @default(cuid())
  eventId       String
  workerId      String
  role          String
  status        String    @default("CONVOCADO")
  respondedAt   DateTime?
  checkIn       String?
  checkOut      String?
  hoursOverride Float?
  notes         String?
  createdAt     DateTime  @default(now())
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  worker        Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([eventId, workerId])
}

// Tarifa por puesto
model Rate {
  role       String @id
  hourlyRate Float
  minHours   Float  @default(0)
}
