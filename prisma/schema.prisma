generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Puestos: CAMARERO | RESPONSABLE (camarero responsable) | MAITRE | MOZO
model Worker {
  id              String           @id @default(cuid())
  name            String
  // Sin teléfono puede entrar con su email (p. ej. personal importado sin móvil)
  phone           String?
  email           String?
  // Puesto principal y todos los puestos que puede desempeñar (incluye el principal).
  // El puesto en cada evento lo marca la convocatoria (Assignment.role)
  role            String
  roles           String[]         @default([])
  rating          Int              @default(3)
  zone            String?
  notes           String?
  // Datos laborales (los puede completar el propio trabajador desde la app)
  dni             String?
  nss             String?
  iban            String?
  birthDate       String?
  address         String?
  // Código del trabajador en A3Nom (para la exportación de horas)
  a3Code          String?
  // Foto de perfil: la sube el trabajador y RRHH la acepta o la rechaza (PENDIENTE | ACEPTADA | RECHAZADA)
  photoFileId     String?          @unique
  photoStatus     String?
  photoNote       String?
  photo           StoredFile?      @relation("workerPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  // Datos para el alta masiva en A3 (si faltan los apellidos se separan del nombre)
  firstName       String?
  surname1        String?
  surname2        String?
  sex             String?
  nationality     String?
  education       String?
  a3Center        String?
  // Tarifa propia de esta persona por tipo de evento ({ "BODA": 14, "EVENTO": 12.5 }); manda sobre la del puesto
  customRates     Json?
  // % de retención de IRPF propio (si es null se usa el general de Ajustes → Pagos)
  irpf            Float?
  // Plazas libres en su coche (null o 0 = no suele llevar coche)
  carSeats        Int?
  // Tipo de contrato en A3: 300 (o vacío) = extra fijo discontinuo, cobra por horas y lleva altas y
  // bajas por actividad; 100 / 200 = fijo con nómina mensual (sus horas solo se controlan)
  contractCode    String?
  // Cuándo se le pidió por WhatsApp que activara los avisos de la app
  pushAskedAt     DateTime?
  // Fijo que no ficha ni cuenta horas (p. ej. maître fijo)
  noClock         Boolean          @default(false)
  // Nómina mensual de un fijo (€): sus servicios valorados con su tarifa se comparan con ella y lo
  // que pase de la nómina se le paga aparte
  monthlySalary   Float?
  active          Boolean          @default(true)
  // Acceso a la app: teléfono normalizado + código de 6 cifras que RRHH entrega al trabajador
  phoneKey        String?          @unique
  accessCode      String
  sessionVersion  Int              @default(0)
  failedLogins    Int              @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime         @default(now())
  unavailabilities Unavailability[]
  assignments     Assignment[]
  messages        Message[]
  devices         Device[]
  reviews         Review[]         @relation("reviewed")
  reviewsGiven    Review[]         @relation("reviewer")
  incidentsReported Incident[]     @relation("incidentReporter")
  documents       WorkerDocument[]
  loans           Loan[]
  swapsFrom       SwapRequest[]    @relation("swapFrom")
  swapsTo         SwapRequest[]    @relation("swapTo")
  files           StoredFile[]     @relation("workerFiles")
  incidentsAbout  Incident[]       @relation("incidentWorker")
  contracts       Contract[]
  candidate       Candidate?
  payLines        PayLine[]
  employments     Employment[]
  pollAnswers     PollAnswer[]
}

// Días en los que el trabajador no está disponible (fecha YYYY-MM-DD)
model Unavailability {
  id       String @id @default(cuid())
  workerId String
  date     String
  reason   String?
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([date])
}

// Tipos: BODA | EVENTO | OTRO. Estado: ABIERTO | CERRADO
model Event {
  id            String       @id @default(cuid())
  name          String
  type          String       @default("BODA")
  date          String
  startTime     String
  endTime       String?
  unloadTime    String?
  venue         String
  // Punto exacto del evento para validar el fichaje por geolocalización
  lat           Float?
  lng           Float?
  client        String?
  // Comercial que lleva el evento
  salesRep      String?
  // Presupuesto de personal (si es null se calcula con el personal necesario, las tarifas y el horario)
  budget        Float?
  budgetNote    String?
  notes         String?
  // Qué debe llevar el personal a este evento (una cosa por línea), además del uniforme de su puesto
  checklist     String?
  // Punto y hora de encuentro para ir juntos al evento
  meetingPoint  String?
  meetingTime   String?
  // Finca y cliente guardados (opcionales; venue/client guardan el texto que se muestra)
  venueId       String?
  clientId      String?
  savedVenue    Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  savedClient   Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  needCamareros Int          @default(0)
  needMaitres   Int          @default(0)
  // Camarero responsable: hace de maître en eventos pequeños
  needResponsables Int       @default(0)
  needMozos     Int          @default(0)
  status        String       @default("ABIERTO")
  // Si alguien rechaza o se retira, convocar automáticamente al siguiente mejor puntuado
  autoReplace   Boolean      @default(true)
  createdAt     DateTime     @default(now())
  assignments   Assignment[]
  swaps         SwapRequest[]
  messages      Message[]
  reads         ChatRead[]
  reviews       Review[]
  incidents     Incident[]
  files         StoredFile[]

  @@index([date])
}

// Estado: CONVOCADO | CONFIRMADO | RECHAZADO | CANCELADO
model Assignment {
  id            String    @id @default(cuid())
  eventId       String
  workerId      String
  role          String
  status        String    @default("CONVOCADO")
  respondedAt   DateTime?
  checkIn       String?
  checkOut      String?
  // Datos del fichaje por GPS (distancia al evento y precisión en metros). *Manual = corregido por RRHH
  checkInLat      Float?
  checkInLng      Float?
  checkInDistance Int?
  checkInAccuracy Int?
  checkInManual   Boolean @default(false)
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutDistance Int?
  checkOutAccuracy Int?
  checkOutManual   Boolean @default(false)
  // Fichado sin cobertura: se guardó en el móvil y se envió al recuperar la señal
  checkInOffline  Boolean @default(false)
  checkOutOffline Boolean @default(false)
  hoursOverride Float?
  // Transporte: PROPIO (va por su cuenta), CONDUZCO (lleva coche) o NECESITO (necesita que le lleven)
  transport     String?
  seats         Int?
  rideWithId    String?
  rideWith      Assignment?  @relation("rides", fields: [rideWithId], references: [id], onDelete: SetNull)
  passengers    Assignment[] @relation("rides")
  // El trabajador se retiró después de haber confirmado
  withdrew      Boolean   @default(false)
  notes         String?
  // Resultado del aviso de la última convocatoria («✓ Android · app 12:03», el error o sin móvil)
  notice        String?
  noticeOk      Boolean?
  noticeAt      DateTime?
  createdAt     DateTime  @default(now())
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  worker        Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  swaps         SwapRequest[]
  contract      Contract?

  @@unique([eventId, workerId])
}

// Tarifa por puesto
model Rate {
  role       String @id
  hourlyRate Float
  minHours   Float  @default(0)
  // Plus fijo por cada servicio (p. ej. +10 € al camarero responsable)
  eventBonus Float  @default(0)
  // €/hora distintos según el tipo de evento ({ "BODA": 13, "EVENTO": 12 }); si falta, hourlyRate
  typeRates  Json?
}

// Mensaje del chat de un evento. workerId nulo = escrito por RRHH (authorName = nombre de quien escribe)
model Message {
  id         String   @id @default(cuid())
  eventId    String
  workerId   String?
  authorName String
  body       String
  // Adjuntos opcionales: foto (StoredFile) y/o ubicación compartida
  fileId     String?
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  worker     Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

// Última lectura del chat. reader = "w:<workerId>" para trabajadores, "rrhh" para RRHH (bandeja compartida)
model ChatRead {
  id         String   @id @default(cuid())
  eventId    String
  reader     String
  lastReadAt DateTime
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, reader])
}

// Dispositivo que recibe notificaciones. kind: web (Web Push) | fcm (Android) | apns (iOS)
model Device {
  id        String   @id @default(cuid())
  kind      String
  token     String   @unique
  keys      Json?
  workerId  String?
  adminName String?
  // «iPhone · web app», «Android · Chrome»… para saber qué móvil es
  label     String?
  // Resultado del último aviso enviado (para ver si llegan)
  lastOkAt  DateTime?
  lastError String?
  lastAt    DateTime?
  createdAt DateTime @default(now())
  worker    Worker?  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

// Valoración que hace un maître del evento a cada miembro de su equipo (puntuaciones de 1 a 5)
model Review {
  id          String   @id @default(cuid())
  eventId     String
  workerId    String
  reviewerId  String
  noShow      Boolean  @default(false)
  punctuality Int?
  appearance  Int?
  service     Int?
  attitude    Int?
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  worker      Worker   @relation("reviewed", fields: [workerId], references: [id], onDelete: Cascade)
  reviewer    Worker   @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([eventId, workerId, reviewerId])
  @@index([workerId, createdAt])
}

// Archivo subido (fotos del chat e incidencias). Se guarda en la base de datos: sin servicios externos.
// scope: CHAT | INCIDENT. El acceso se comprueba según el evento al que pertenece.
model StoredFile {
  id         String   @id @default(cuid())
  eventId    String?
  scope      String
  mime       String
  size       Int
  // Contenido: en el almacén de archivos (storageKey, cifrado) o, si no hay almacén configurado, aquí
  data       Bytes?
  storageKey String?
  createdAt  DateTime @default(now())
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // Documentos del trabajador (scope DOC): solo los ven RRHH y el propio trabajador
  workerId   String?
  worker     Worker?  @relation("workerFiles", fields: [workerId], references: [id], onDelete: Cascade)
  photoOf    Worker?  @relation("workerPhoto")
  document   WorkerDocument?
  candidate  Candidate?
  signatureOf Contract?
}

// Incidencia del evento. type: ROTURA | QUEJA | ACCIDENTE | PERSONAL | OTRO
model Incident {
  id          String       @id @default(cuid())
  eventId     String
  type        String
  description String
  // Quién la registra: un trabajador (maître/responsable) o RRHH
  reporterId  String?
  reporterAdmin String?
  // Trabajador afectado o implicado (opcional)
  workerId    String?
  resolved    Boolean      @default(false)
  resolution  String?
  createdAt   DateTime     @default(now())
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporter    Worker?      @relation("incidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  worker      Worker?      @relation("incidentWorker", fields: [workerId], references: [id], onDelete: SetNull)
  photos      StoredFile[]

  @@index([eventId])
  @@index([resolved, createdAt])
}

// Registro de avisos automáticos ya enviados (evita duplicados). key p. ej. "dia-antes:<assignmentId>"
model ReminderLog {
  key    String   @id
  sentAt DateTime @default(now())
}

// Usuario de RRHH. Todos tienen acceso completo. sessionVersion cierra sus sesiones al desactivarlo o cambiar la contraseña.
model AdminUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  active         Boolean   @default(true)
  sessionVersion Int       @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  // Verificación en dos pasos: código de un solo uso enviado por email al entrar desde un navegador nuevo
  loginCodeHash    String?
  loginCodeExpires DateTime?
  loginCodeTries   Int       @default(0)
  createdAt      DateTime  @default(now())
  staffRooms     StaffRoomMember[]
}

// Finca o lugar habitual: dirección, punto para el fichaje e indicaciones para el personal
model Venue {
  id           String          @id @default(cuid())
  name         String          @unique
  address      String?
  lat          Float?
  lng          Float?
  accessNotes  String?
  contactName  String?
  contactPhone String?
  createdAt    DateTime        @default(now())
  events       Event[]
  templates    EventTemplate[]
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  events    Event[]
}

// Plantilla de evento: personal necesario, horario y notas habituales
model EventTemplate {
  id               String   @id @default(cuid())
  name             String   @unique
  type             String   @default("BODA")
  startTime        String
  endTime          String
  unloadTime       String?
  needCamareros    Int      @default(0)
  needResponsables Int      @default(0)
  needMaitres      Int      @default(0)
  needMozos        Int      @default(0)
  notes            String?
  checklist        String?
  venueId          String?
  venue            Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
}

// Documento del trabajador. type: DNI | NSS | MANIPULADOR | CUENTA | CONTRATO | OTRO
model WorkerDocument {
  id         String      @id @default(cuid())
  workerId   String
  type       String
  label      String?
  expiresAt  String?
  fileId     String?     @unique
  verified   Boolean     @default(false)
  uploadedBy String
  createdAt  DateTime    @default(now())
  worker     Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([expiresAt])
}

// Intercambio de turno: quien no puede ir propone a un compañero, este acepta y RRHH lo aprueba.
// status: PROPUESTO | ACEPTADO (por el compañero) | APROBADO | RECHAZADO | CANCELADO
model SwapRequest {
  id           String     @id @default(cuid())
  assignmentId String
  eventId      String
  fromWorkerId String
  toWorkerId   String
  status       String     @default("PROPUESTO")
  message      String?
  decidedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromWorker   Worker     @relation("swapFrom", fields: [fromWorkerId], references: [id], onDelete: Cascade)
  toWorker     Worker     @relation("swapTo", fields: [toWorkerId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Material prestado al trabajador (chaqueta, sacacorchos, bandeja…)
model Loan {
  id          String    @id @default(cuid())
  workerId    String
  item        String
  quantity    Int       @default(1)
  deliveredAt String
  returnedAt  String?
  notes       String?
  createdAt   DateTime  @default(now())
  worker      Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

// Ajustes generales (p. ej. uniforme por puesto: key "uniforme", value { CAMARERO: [..], ... })
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Candidato que se apunta desde el formulario público «Trabaja con nosotros».
// status: NUEVO | CONTACTADO | DESCARTADO | CONTRATADO
model Candidate {
  id           String      @id @default(cuid())
  name         String
  phone        String
  phoneKey     String
  email        String?
  zone         String?
  roles        String[]
  experience   String?
  availability String?
  // ¿Tiene coche para ir a los eventos?
  hasCar       Boolean?
  fileId       String?     @unique
  status       String      @default("NUEVO")
  notes        String?
  consentAt    DateTime
  workerId     String?     @unique
  createdAt    DateTime    @default(now())
  // Cuándo lo abrió RRHH por primera vez (hasta entonces cuenta como nuevo en el menú)
  seenAt       DateTime?
  file         StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  worker       Worker?     @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// Documento de condiciones del servicio para firmar por el trabajador (texto congelado al generarlo)
model Contract {
  id              String      @id @default(cuid())
  // CONDICIONES: condiciones del servicio de un evento. RGPD: cláusula de protección de datos
  kind            String      @default("CONDICIONES")
  // Versión del texto de protección de datos firmada (si cambia, hay que volver a firmar)
  version         Int?
  assignmentId    String?     @unique
  workerId        String
  eventId         String?
  title           String
  body            String
  createdBy       String
  createdAt       DateTime    @default(now())
  signedAt        DateTime?
  signerName      String?
  signerIp        String?
  signatureFileId String?     @unique
  // Datos estructurados (registro de jornada: días y horas) y observaciones del trabajador al firmar
  data            Json?
  signerNote      String?
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker          Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  signature       StoredFile? @relation(fields: [signatureFileId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([workerId, kind])
}

// Quincena de pago (pagamos a quincena vencida: 1-15 el día 22, 16-fin la primera semana del mes siguiente).
// ABIERTA: importes calculados en vivo. CERRADA: importes congelados (al generar la remesa). PAGADA.
model PayPeriod {
  id          String       @id @default(cuid())
  from        String
  to          String
  payDate     String
  status      String       @default("ABIERTA")
  closedAt    DateTime?
  paidAt      DateTime?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  lines       PayLine[]
  remittances Remittance[]

  @@unique([from, to])
}

// Línea de pago de un trabajador en una quincena. Mientras está ABIERTA solo guarda el neto real
// si RRHH lo ha puesto o importado (netOverride); al cerrar se congelan todos los importes.
model PayLine {
  id          String    @id @default(cuid())
  periodId    String
  workerId    String
  services    Int       @default(0)
  hours       Float     @default(0)
  gross       Float     @default(0)
  ss          Float     @default(0)
  irpf        Float     @default(0)
  netEstimate Float     @default(0)
  netOverride Float?
  iban        String?
  period      PayPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  worker      Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([periodId, workerId])
}

// Remesa SEPA (pain.001.001.03) generada para pagar una quincena
model Remittance {
  id        String    @id @default(cuid())
  periodId  String
  msgId     String    @unique
  count     Int
  total     Float
  execDate  String
  xml       String
  createdBy String
  createdAt DateTime  @default(now())
  period    PayPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

// Altas y bajas en la Seguridad Social (sustituye al Excel de altas y bajas)
model Employment {
  id              String    @id @default(cuid())
  workerId        String
  startDate       String
  endDate         String?
  contractType    String
  category        String?
  hoursPerWeek    Float?
  endReason       String?
  notes           String?
  // Comunicado a la Seguridad Social (Sistema RED)
  startReported   Boolean   @default(false)
  endReported     Boolean   @default(false)
  // Generada sola a partir del personal confirmado (días seguidos = un alta; se baja el último día)
  auto            Boolean   @default(false)
  // Aviso para RRHH (p. ej. cambió después de comunicarla a la Seguridad Social)
  warning         String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  worker          Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, startDate])
}

// Sondeo de disponibilidad: «¿qué días puedes trabajar?» antes de convocar
model AvailabilityPoll {
  id        String       @id @default(cuid())
  title     String
  message   String?
  dates     String[]
  roles     String[]
  createdBy String
  createdAt DateTime     @default(now())
  closedAt  DateTime?
  answers   PollAnswer[]
}

model PollAnswer {
  id         String           @id @default(cuid())
  pollId     String
  workerId   String
  date       String
  available  Boolean
  answeredAt DateTime         @default(now())
  poll       AvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  worker     Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([pollId, workerId, date])
  @@index([workerId, date])
}

// Registro de cambios: quién cambió qué y cuándo
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actor     String
  actorKind String
  action    String
  entity    String
  entityId  String?
  summary   String
  data      Json?

  @@index([at])
  @@index([entity, entityId])
}

// ---------- Chat interno de RRHH (solo usuarios de RRHH) ----------

// GENERAL: todo RRHH (un único grupo, todos los usuarios activos) · DIRECTO: dos personas · GRUPO: con nombre y miembros elegidos
model StaffRoom {
  id            String            @id @default(cuid())
  kind          String
  name          String?
  createdBy     String
  createdAt     DateTime          @default(now())
  lastMessageAt DateTime          @default(now())
  members       StaffRoomMember[]
  messages      StaffMessage[]

  @@index([lastMessageAt])
}

model StaffRoomMember {
  id         String    @id @default(cuid())
  roomId     String
  adminId    String
  lastReadAt DateTime  @default(now())
  room       StaffRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([roomId, adminId])
  @@index([adminId])
}

model StaffMessage {
  id         String    @id @default(cuid())
  roomId     String
  adminId    String?
  authorName String
  body       String
  fileId     String?
  createdAt  DateTime  @default(now())
  room       StaffRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// Evento en borrador del cuadrante: no lo ve nadie más que RRHH ni avisa a nadie. Al confirmarlo se
// crea el evento de verdad con los datos del formulario y se convoca al personal elegido.
model EventDraft {
  id        String   @id @default(cuid())
  name      String
  date      String
  // Campos del formulario del evento tal cual (se validan al confirmar)
  form      Json
  // Personal previsto: [{ workerId, role }]
  staff     Json     @default("[]")
  createdBy String
