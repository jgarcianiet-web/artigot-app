# Base de datos PostgreSQL (en Railway se rellena sola al añadir el servicio Postgres)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/artigot"

# Contraseña de acceso para RRHH
ADMIN_PASSWORD="cambia-esta-clave"

# Secreto para firmar la sesión (cadena larga y aleatoria)
SESSION_SECRET="genera-una-cadena-larga-y-aleatoria"

# URL pública de la app, usada en los enlaces que se envían al personal
APP_URL="http://localhost:3000"

# Avisos web (navegador y web app). Genera las claves con: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:rrhh@tuempresa.es"

# Avisos en la app Android: JSON de la cuenta de servicio de Firebase (tal cual o en base64)
FCM_SERVICE_ACCOUNT=""

# Avisos en la app iPhone: clave .p8 de APNs (con \n para los saltos de línea), su ID, el Team ID y el bundle ID
APNS_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="es.artigot.personal"

# Enlaces de descarga que aparecen en las instrucciones de acceso del trabajador (opcional)
ANDROID_APK_URL=""
IOS_APP_URL=""

# Distancia máxima (metros) al punto del evento para poder fichar
CLOCK_RADIUS_M="200"
