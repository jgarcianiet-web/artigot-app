# Base de datos (SQLite local). Para producción puede usarse PostgreSQL cambiando el provider en prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Contraseña de acceso para RRHH
ADMIN_PASSWORD="cambia-esta-clave"

# Secreto para firmar la sesión (cadena larga y aleatoria)
SESSION_SECRET="genera-una-cadena-larga-y-aleatoria"

# URL pública de la app, usada en los enlaces que se envían al personal
APP_URL="http://localhost:3000"
